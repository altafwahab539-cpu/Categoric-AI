# GEMINI_API_KEY: Required for Google Gemini & Veo 3.1 video generation
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (for production deployments)
DATABASE_URL="postgresql://postgres:password@localhost:5432/categoric_ai"

# JWT_SECRET: Secret used for signing authentication session tokens
JWT_SECRET="categoric_ai_jwt_production_secret_key_change_in_prod"

# STRIPE: Payment credentials for SaaS subscriptions and credit packs
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# STORAGE: Object storage configuration (GCS / AWS S3 / Cloudflare R2)
STORAGE_BUCKET="categoric-ai-videos"
STORAGE_REGION="us-central1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

